    "@prisma/client": "^5.22.0",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "cashfree-pg": "^6.0.6",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-fileupload": "^1.5.1",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^10.9.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.1.1",
    "prisma": "^5.22.0",
    "puppeteer": "^25.12.0",
    "sanitize-html": "^2.18.0",
    "zod": "^3.25.76"

{
  "name": "forensiq-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon index.js",
    "start": "node index.js",
    "db:studio": "npx prisma studio --schema=config/database/schema.prisma",
    "db:push": "npx prisma db push --schema=config/database/schema.prisma",
    "db:migrate": "npx prisma migrate dev --schema=config/database/schema.prisma",
    "db:generate": "npx prisma generate --schema=config/database/schema.prisma",
    "postinstall": "npx prisma generate --schema=config/database/schema.prisma",
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\"",
    "db:validate": "prisma validate --schema=config/database/schema.prisma"
  },
  "keywords": [],
  "author": "",

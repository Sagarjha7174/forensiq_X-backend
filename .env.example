# ForensIQ backend — example environment. Copy to .env and fill in. Never commit .env.
NODE_ENV=production
PORT=5000
# Number of reverse proxies in front of the app (Render/Vercel/Nginx = 1). 0 if exposed directly.
TRUST_PROXY=1

# Database (PostgreSQL)
DB_URL=
DIRECT_URL=

# Auth
JWT_SECRET=            # long random string (>= 32 bytes), e.g. `openssl rand -base64 48`
ADMIN_EMAIL=
GOOGLE_CLIENT_ID=      # OAuth client id used by the frontend
GOOGLE_CLIENT_IDS=     # optional: comma-separated list if several client ids are legitimate

# CORS — exact origins only (scheme://host[:port]), comma separated
FRONTEND_URL=          # primary frontend URL (also used in emails)
FRONTEND_URLS=
CORS_ALLOWED_ORIGINS=  # e.g. specific Vercel preview URLs

# Cloudinary
CLOUD_NAME=
API_KEY=
API_SECRET=

# Public https origin of this API; sent to Cashfree as the per-order webhook URL
PUBLIC_API_URL=

# Cashfree (production credentials; webhook signature uses CASHFREE_SECRET_KEY)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# SMTP
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=
MAIL_FROM_ADDRESS=
